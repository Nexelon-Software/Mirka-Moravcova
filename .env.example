# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
# Public URL of the app (e.g. https://mirka.sk or http://localhost:3000)
BETTER_AUTH_URL=""

# Better Auth Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public server URL (used client-side, e.g. https://mirka.sk)
NEXT_PUBLIC_SERVER_URL=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Local Postgres:
DATABASE_URL="postgresql://postgres:password@localhost:5432/mirka-moravcova"
# Supabase transaction pooler (port 6543) must include pgbouncer=true so Prisma
# does not use prepared statements (error 26000: prepared statement does not exist).
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/db?pgbouncer=true"

# UploadThing (https://uploadthing.com)
# Token from the UploadThing dashboard API keys tab. Never commit the real value.
UPLOADTHING_TOKEN=""
